{
  "service": "StatistiquesFilms",
  "description": "Projection des avis pour consulter rapidement les films les mieux notes",
  "evenements_recus": [
    {
      "evenement": "AvisPublie",
      "service_emetteur": "AvisEtFidelite",
      "effet": "somme_notes += note ; nombre_avis += 1"
    },
    {
      "evenement": "AvisModifie",
      "service_emetteur": "AvisEtFidelite",
      "effet": "somme_notes += nouvelle note - ancienne note"
    },
    {
      "evenement": "AvisSupprime",
      "service_emetteur": "AvisEtFidelite",
      "effet": "somme_notes -= note ; nombre_avis -= 1"
    }
  ],
  "regles_transformation": {
    "note_moyenne": "somme_notes / nombre_avis (0 si aucun avis)",
    "nombre_avis": "nombre total d'avis publies pour le film"
  },
  "agregat_projete": {
    "EvaluationFilm": {
      "id_film": "FILM001",
      "titre": "Avatar : La Voie de l'eau",
      "somme_notes": 5,
      "nombre_avis": 1,
      "note_moyenne": 5.0
    }
  },
  "requete": {
    "nom": "ConsulterFilmsLesMieuxNotes",
    "filtres": {
      "note_minimale": 4.0
    },
    "tri": {
      "champ": "note_moyenne",
      "ordre": "decroissant"
    },
    "limite": 10
  }
}
